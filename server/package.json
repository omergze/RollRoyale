{
  "name": "rollroyale-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.42",
    "@colyseus/ws-transport": "0.18.4",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "colyseus": "0.18.10",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.8",
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
